{
  "use_mllm_object_parser": true,
  "nlp_model_name": "en_core_web_sm",
  "enable_direct_answer": true,
  "direct_answer_conf_threshold": 0.6,
  "enable_fast_path": true,
  "fast_path_conf_threshold": 0.7,
  "enable_visual_prompt_bbox": true,
  "enable_textual_prompt_coords": false,
  "visual_prompt_bbox_color": "red",
  "visual_prompt_bbox_width": 3,
  "entropy_threshold": 0.35,
  "min_patch_entropy": 0.35,
  "entropy_weights": [
    0.35,
    0.35,
    0.3
  ],
  "partition_mode": "hybrid",
  "sgap_min_splits": 4,
  "sgap_max_splits": 8,
  "sgap_n_atoms": 100,
  "quadrant_overlap_ratio": 0.1,
  "sgap_overlap_ratio": 0.1,
  "partition_stopping_mode": "saliency_plateau",
  "max_patch_size": 512,
  "min_plateau_size": 256,
  "max_plateau_size": 1536,
  "saliency_plateau_gain_threshold": 0.04,
  "saliency_target_threshold": 0.35,
  "max_partition_depth": 3,
  "max_patches_per_image": 100,
  "stage3_budget_mode": "siglip_similarity",
  "siglip_budget_batch_size": 32,
  "reuse_stage2_features": true,
  "enable_feature_grouping": true,
  "grouping_sim_threshold": 0.8,
  "reuse_stage3_features": true,
  "sam3_group_det_threshold": 0.35,
  "enable_latent_gating": true,
  "latent_confidence_threshold": 0.0,
  "latent_prompt_mode": "question_aware",
  "latent_prompt_template": "According to your common sense knowledge and the content of the image, is it possible to find a {} by further zooming the sub-patch? Answer Yes or No.",
  "latent_prompt_template_qa": "According to visual common sense and the content of the image, is it possible to find the information needed to answer '{}' by further zooming the sub-patch? Answer Yes or No.",
  "enable_existence_gating": true,
  "existence_confidence_threshold": 0.0,
  "existence_prompt_template": "Is there a '{}' in the image? Answer Yes or No.",
  "bypass_vlm_for_confirmed_groups": true,
  "max_latent_evals": 8,
  "enable_prioritized_sam3_scanning": true,
  "max_sam3_eval_patches": 16,
  "enable_group_retention_caps": true,
  "max_patches_per_latent_group": 1,
  "max_patches_per_detected_group": 4,
  "enable_retention_hard_cap": true,
  "max_retained_patches": 32,
  "retention_ranking_metric": "confidence_hybrid",
  "siglip_model_name": "google/siglip-base-patch16-384",
  "siglip_device": "cuda:0",
  "enable_stage5_spatial_nms": true,
  "stage5_nms_iou_threshold": 0.6,
  "enable_spatial_compressed_canvas": true,
  "spatial_compression_gutter_px": 28,
  "vlm_batch_size": 4,
  "bbox_expansion_factor": 1.25,
  "max_vlm_tokens": 128,
  "enable_early_consensus_exit": false,
  "early_consensus_count": 2,
  "early_consensus_threshold": 0.75,
  "prompt_directed_final_answer": true,
  "answer_dedup_similarity": 0.85,
  "include_options_in_prompt": false,
  "answer_type": "free_form",
  "multi_answer_mode": false,
  "scale_budgets_by_num_images": true,
  "enable_query_adaptive_halting": true,
  "verbose": true,
  "stage_summary_only": true,
  "log_level": "summary"
}
